<Window x:Class="JiaoLongControl.Server.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSD"
        Width="440"
        Height="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <!-- 状态强调色光晕: 进场浮现 / 驻留呼吸 / 退场消散 (尺寸由代码按缩放设置) -->
        <!-- 不参与命中: 只允许胶囊本体接收鼠标, 窗口空区保持穿透 -->
        <Ellipse x:Name="Halo"
                 Opacity="0"
                 IsHitTestVisible="False"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="HaloStop"
                                  Color="#593B82F6"
                                  Offset="0" />
                    <GradientStop Color="#003B82F6"
                                  Offset="0.72" />
                    <GradientStop Color="#003B82F6"
                                  Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HaloScale" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- 灵动岛胶囊: 深色亚克力质感近似 (渐变底板 + 高光描边 + 柔和投影) -->
        <!-- 不用 Viewbox 几何缩放: 变换会让 WPF 对文本禁用 ClearType 导致发虚,
             改为代码按缩放比例直接设置尺寸与字号, 文本按最终尺寸排版保持清晰 -->
        <Border x:Name="Pill"
                Opacity="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                BorderThickness="1">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale" />
                    <TranslateTransform x:Name="PillTranslate" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="2"
                                  Opacity="0.35"
                                  Color="#000000" />
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="PanelTop"
                                  Color="#F217171C"
                                  Offset="0" />
                    <GradientStop x:Name="PanelBottom"
                                  Color="#E90E0E12"
                                  Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush x:Name="PanelBorder" Color="#24FFFFFF" />
            </Border.BorderBrush>
            <Grid ClipToBounds="True">
                <Border x:Name="HoverGlow"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush x:Name="HoverGlowBrush"
                                             Center="160,20"
                                             GradientOrigin="160,20"
                                             RadiusX="20"
                                             RadiusY="20"
                                             MappingMode="Absolute">
                            <GradientStop x:Name="HoverGlowStop"
                                          Color="#45FFFFFF"
                                          Offset="0" />
                            <GradientStop Color="#12FFFFFF"
                                          Offset="0.55" />
                            <GradientStop Color="#00FFFFFF"
                                          Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Grid x:Name="ContentGrid" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 状态图标: 强调色着色 + 微光晕 -->
                    <Grid x:Name="IconBox"
                          Width="26"
                          Height="26"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center">
                        <Ellipse x:Name="IconGlow" Opacity="0.4">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop x:Name="IconGlowStop"
                                                  Color="#663B82F6"
                                                  Offset="0" />
                                    <GradientStop Color="#003B82F6"
                                                  Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="IconGlyph"
                                   Text="&#xE767;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#3B82F6"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <!-- PNG 图标 (锁定键/触摸板等): 素材为黑色剪影, 读取后透明度归一化,
                             经 OpacityMask 以强调色着色渲染 (与 IconGlyph 字形同色), 显示时隐藏字形 -->
                        <Rectangle x:Name="IconImage"
                                   Width="18"
                                   Height="18"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <Rectangle.OpacityMask>
                                <ImageBrush x:Name="IconImageBrush" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- 标题裁剪容器: Canvas 不约束子元素宽度, TitleText 始终保持自然全宽
                             (无省略号截断), 媒体 OSD 长曲名超出时经 TitleTranslate 整体平移 -->
                        <Grid x:Name="TitleClip" ClipToBounds="True">
                            <Canvas x:Name="TitleCanvas" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText"
                                           Canvas.Left="0"
                                           Canvas.Top="0"
                                           Text="音量"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#F2FFFFFF">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="TitleTranslate" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </Grid>
                        <TextBlock x:Name="SubtitleText"
                                   Text="72%"
                                   FontSize="10"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#8CFFFFFF" />
                    </StackPanel>

                    <!-- 右侧区域: 按当前 OSD 类型切换可见性
                         (纯值进度条已由交互控件取代, 保留容器名供出入场动画引用) -->
                    <Grid x:Name="BarPanel" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <!-- 音量: 可拖动/点击的进度条 + 静音切换小按钮 -->
                        <StackPanel x:Name="VolumePanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Border x:Name="VolumeSliderHit"
                                    Width="84"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="VolumeSliderHit_MouseLeftButtonDown"
                                    MouseMove="VolumeSliderHit_MouseMove"
                                    MouseLeftButtonUp="VolumeSliderHit_MouseLeftButtonUp"
                                    MouseEnter="VolumeSliderHit_MouseEnter"
                                    MouseLeave="VolumeSliderHit_MouseLeave">
                                <Grid x:Name="VolumeBar" Height="4" VerticalAlignment="Center">
                                    <Border x:Name="VolumeTrack"
                                            CornerRadius="2"
                                            Background="#24FFFFFF" />
                                    <Border x:Name="VolumeFill"
                                            CornerRadius="2"
                                            HorizontalAlignment="Left"
                                            Width="60" />
                                </Grid>
                            </Border>
                            <Border x:Name="MuteButton"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    CornerRadius="11"
                                    MouseLeftButtonUp="MuteButton_MouseLeftButtonUp">
                                <TextBlock x:Name="MuteGlyph"
                                           Text="&#xE767;"
                                           FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- 键盘背光: 0~3 档可点击分段 -->
                        <StackPanel x:Name="BrightnessPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Border x:Name="Seg0"
                                    Width="18"
                                    Height="16"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    Tag="0"
                                    MouseLeftButtonDown="Segment_MouseLeftButtonDown">
                                <Border x:Name="Seg0Fill" Height="8" CornerRadius="2" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Seg1"
                                    Width="18"
                                    Height="16"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    Tag="1"
                                    MouseLeftButtonDown="Segment_MouseLeftButtonDown">
                                <Border x:Name="Seg1Fill" Height="8" CornerRadius="2" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Seg2"
                                    Width="18"
                                    Height="16"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    Tag="2"
                                    MouseLeftButtonDown="Segment_MouseLeftButtonDown">
                                <Border x:Name="Seg2Fill" Height="8" CornerRadius="2" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Seg3"
                                    Width="18"
                                    Height="16"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    Tag="3"
                                    MouseLeftButtonDown="Segment_MouseLeftButtonDown">
                                <Border x:Name="Seg3Fill" Height="8" CornerRadius="2" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- 媒体: 上一曲 / 播放暂停 / 下一曲 -->
                        <StackPanel x:Name="MediaPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Border x:Name="MediaPrev"
                                    Width="22"
                                    Height="22"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    CornerRadius="11"
                                    MouseLeftButtonUp="MediaPrev_MouseLeftButtonUp">
                                <TextBlock x:Name="MediaPrevGlyph"
                                           Text="&#xE892;"
                                           FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="MediaPlayPause"
                                    Width="22"
                                    Height="22"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    CornerRadius="11"
                                    MouseLeftButtonUp="MediaPlayPause_MouseLeftButtonUp">
                                <TextBlock x:Name="PlayPauseGlyph"
                                           Text="&#xE769;"
                                           FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="MediaNext"
                                    Width="22"
                                    Height="22"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    CornerRadius="11"
                                    MouseLeftButtonUp="MediaNext_MouseLeftButtonUp">
                                <TextBlock x:Name="MediaNextGlyph"
                                           Text="&#xE893;"
                                           FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

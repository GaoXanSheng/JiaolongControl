<Window x:Class="JiaoLongControl.Server.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件更新" Height="430" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Text="发现新版本！" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- 版本对比 -->
        <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="当前版本" FontSize="12" Foreground="#888"/>
                    <TextBlock x:Name="TxtCurrentVersion" FontSize="15"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="  →  " FontSize="18" VerticalAlignment="Center"
                           Foreground="#4A90D9" Margin="8,0"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="最新版本" FontSize="12" Foreground="#888"/>
                    <TextBlock x:Name="TxtNewVersion" FontSize="15" FontWeight="Bold" Foreground="#4A90D9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 更新日志 -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#FAFAFA" Padding="10,6" CornerRadius="3,3,0,0">
                    <TextBlock Text="更新日志" FontSize="13" FontWeight="SemiBold" Foreground="#555"/>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <TextBlock x:Name="TxtReleaseNotes" TextWrapping="Wrap" FontSize="13"
                               Foreground="#444" LineHeight="20"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 下载进度 (默认隐藏) -->
        <StackPanel x:Name="DownloadPanel" Grid.Row="3" Visibility="Collapsed">
            <TextBlock x:Name="TxtDownloadStatus" FontSize="12" Foreground="#666" Margin="0,0,0,6"/>
            <ProgressBar x:Name="DownloadProgress" Height="6" Margin="0,0,0,8"/>
            <Button Content="取消下载" Width="80" Height="26" HorizontalAlignment="Right"
                    Click="BtnCancelDownload_Click"/>
        </StackPanel>

        <!-- 操作按钮 (下载时隐藏) -->
        <StackPanel x:Name="ButtonPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="立即更新" Width="90" Height="30" Click="BtnUpdate_Click"
                    IsDefault="True" Margin="5,0"
                    Background="#4A90D9" Foreground="White" BorderThickness="0"/>
            <Button Content="跳过该版本" Width="90" Height="30" Click="BtnSkip_Click" Margin="5,0"/>
            <Button Content="稍后提醒" Width="90" Height="30" Click="BtnLater_Click"
                    IsCancel="True" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>
